# --- Database -----------------------------------------------------------
# Migrations run as the owner; the application connects as a NOSUPERUSER role
# that cannot bypass row-level security. This split is load-bearing, not cosmetic.
GK_DATABASE_OWNER_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/gatekeeper
GK_DATABASE_URL=postgresql+asyncpg://gatekeeper_app:gatekeeper_app@localhost:5433/gatekeeper

# --- Object storage -----------------------------------------------------
GK_S3_ENDPOINT_URL=http://localhost:9002
GK_S3_ACCESS_KEY=gatekeeper
GK_S3_SECRET_KEY=gatekeeper
GK_S3_BUCKET=gatekeeper-raw

# --- Redis --------------------------------------------------------------
GK_REDIS_URL=redis://localhost:6380/0

# --- Model providers (Phase 1; all optional, local ONNX is the default) ---
# GK_OPENAI_API_KEY=
# GK_ANTHROPIC_API_KEY=
GK_EMBEDDING_BACKEND=local

GK_LOG_LEVEL=INFO
