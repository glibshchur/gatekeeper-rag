# --- Database -----------------------------------------------------------
# Migrations run as the owner; the application connects as a NOSUPERUSER role
# that cannot bypass row-level security. This split is load-bearing, not cosmetic.
GK_DATABASE_OWNER_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/gatekeeper
GK_DATABASE_URL=postgresql+asyncpg://gatekeeper_app:gatekeeper_app@localhost:5433/gatekeeper

# --- Object storage -----------------------------------------------------
GK_S3_ENDPOINT_URL=http://localhost:9002
GK_S3_ACCESS_KEY=gatekeeper
GK_S3_SECRET_KEY=gatekeeper
GK_S3_BUCKET=gatekeeper-raw

# --- Redis --------------------------------------------------------------
GK_REDIS_URL=redis://localhost:6380/0

# --- Model providers (Phase 1; all optional, local ONNX is the default) ---
# GK_OPENAI_API_KEY=
# GK_ANTHROPIC_API_KEY=
GK_EMBEDDING_BACKEND=local

# --- authentication -----------------------------------------------------
# "dev" verifies HS256 tokens signed locally, so the system runs with no identity
# provider. Mint one with `gatekeeper token --as raj`.
GK_AUTH_MODE=dev
# Refusing the shipped default is deliberate; set your own, or accept the risk below.
# GK_AUTH_DEV_SECRET=
GK_ALLOW_INSECURE_DEV_AUTH=1
# For oidc mode:
# GK_AUTH_MODE=oidc
# GK_OIDC_JWKS_URL=http://localhost:8080/realms/gatekeeper/protocol/openid-connect/certs
# GK_OIDC_ISSUER=http://localhost:8080/realms/gatekeeper
# GK_OIDC_AUDIENCE=gatekeeper

# The MCP server serves exactly one principal for its lifetime.
# GK_MCP_PRINCIPAL=raj

GK_LOG_LEVEL=INFO
